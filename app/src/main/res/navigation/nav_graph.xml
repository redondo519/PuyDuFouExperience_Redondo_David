<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/espectaculosFragment">

    <fragment
        android:id="@+id/espectaculosFragment"
        android:name="com.redondo.puydufouexperience.ui.EspectaculosFragment"
        android:label="Espectáculos" >
        <!-- Ir a Detalle de Espectaculo -->
        <action
            android:id="@+id/action_espectaculosFragment_to_espectaculoDetalleFragment"
            app:destination="@id/espectaculoDetalleFragment" />
    </fragment>


    <fragment
        android:id="@+id/mapaFragment"
        android:name="com.redondo.puydufouexperience.ui.MapaFragment"
        android:label="Mapa" />

    <fragment
        android:id="@+id/favoritosFragment"
        android:name="com.redondo.puydufouexperience.ui.FavoritosFragment"
        android:label="Favoritos" />

    <fragment
        android:id="@+id/ajustesFragment"
        android:name="com.redondo.puydufouexperience.ui.AjustesFragment"
        android:label="Ajustes" />

    <!-- Detalle de Espectaculo -->
    <fragment
        android:id="@+id/espectaculoDetalleFragment"
        android:name="com.redondo.puydufouexperience.ui.EspectaculoDetalleFragment"
        android:label="Detalle Espectáculo">

        <argument
            android:name="espectaculoId"
            app:argType="integer" />
    </fragment>


</navigation>
